{
  "name": "react-dashboard-new",
  "version": "2.1.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run && node --test server/*.test.mjs",
    "server": "node --env-file-if-exists=.env.local server/start.mjs",
    "db:init": "node --env-file-if-exists=.env.local server/init-db.mjs",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=24.22.3"
  },
  "dependencies": {
    "@popperjs/core": "^2.11.8",
    "@react-google-maps/api": "^2.20.8",
    "@reduxjs/toolkit": "^2.11.2",
    "bootstrap": "^5.3.8",
    "classnames": "^2.5.1",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "graphql": "^16.15.0",
    "graphql-http": "^1.23.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "prop-types": "^15.8.1",
    "react": "^19.2.4",
    "react-bootstrap-icons": "^1.11.6",
    "react-dom": "^19.2.4",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.18.5",
    "react-toastify": "^11.0.5",
    "reactstrap": "^9.2.3",
    "recharts": "^3.8.0",
    "sass": "^1.98.0"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.8"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.4.0",
    "jsdom": "^29.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.1",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  }
}
